# Base de l'API Sentinel-X (backend Express)
VITE_API_URL=http://localhost:3000/api

# URL du flux vidéo de la caméra (MJPEG / HLS / mp4).
# Laisser vide tant que le flux n'est pas disponible :
# le panneau affiche alors un message d'attente.
VITE_CAMERA_URL=

# API matérielle qui reçoit les ordres (buzzer, ouverture de porte).
# Correspond à /api/v1/commandes du backend tant que l'endpoint n'existe pas.
VITE_COMMANDS_API_URL=http://localhost:3000/api/v1/commandes
