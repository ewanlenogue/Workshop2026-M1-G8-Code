# Base de l'API Sentinel-X (backend Express)
VITE_API_URL=http://localhost:3000/api

# Flux caméra diffusé par le module IA (ia/script_ia.py).
#   - URL MJPEG (http://…/stream.mjpg) affichée avec <img>
#   - URL vidéo (…mp4/m3u8) affichée avec <video>
#   - vide = panneau caméra désactivé
VITE_CAMERA_URL=http://localhost:8080/stream.mjpg

# API matérielle qui reçoit les ordres (buzzer, ouverture de porte).
VITE_COMMANDS_API_URL=http://localhost:3000/api/v1/commandes
